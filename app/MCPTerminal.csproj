<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MCPTerminal</AssemblyName>
    <RootNamespace>MCPTerminal</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyTitle>MCPTerminal</AssemblyTitle>
    <Product>MCPTerminal</Product>
    <Description>Shared terminal - a real shell both you and an AI assistant can type into</Description>
    <Version>2.1.0</Version>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-musl-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>

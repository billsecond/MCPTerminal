<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MCPTerminalStudio</AssemblyName>
    <RootNamespace>MCPTerminal.Studio</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>MCPTerminal Studio</AssemblyTitle>
    <Product>MCPTerminal Studio</Product>
    <Description>Terminal manager for MCPTerminal shared sessions - tabs per conversation, Cursor-style terminal list, history search</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- shared core with the standalone terminal app -->
    <Compile Include="..\app\PtyCore.cs" Link="PtyCore.cs" />
    <Compile Include="..\app\ShellSupport.cs" Link="ShellSupport.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!--
    The WebView2 package ships both a WinForms and a WPF binding. This app only
    uses the WinForms one; the WPF assembly targets .NET 5 WPF and drags in
    WindowsBase 5.0.0.0, which conflicts with the 4.0.0.0 this WinForms app
    resolves (MSB3277). Drop the unused WPF reference so there is no conflict.
  -->
  <Target Name="DropUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="ui.html" CopyToOutputDirectory="PreserveNewest" />
    <!-- vendored browser assets (xterm.js + addon-fit, MIT) - no CDN at runtime -->
    <None Include="vendor\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
